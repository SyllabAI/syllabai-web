# SyllabAI web: environment variables (Vercel → Settings → Environment Variables)
# Local dev: copy to .env.local (git-ignored).

# Bare origin of the Spring Boot API (Render service) — no trailing /api/v1
# (client request paths already carry the /api/v1 prefix; a trailing /api/v1
# is tolerated and normalized away, but the bare origin is canonical).
# Unset => same-origin /api/v1 requests (reverse-proxy / sandbox gateway mode).
NEXT_PUBLIC_API_BASE_URL=
